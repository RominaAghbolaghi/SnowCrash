چون از -M intel استفاده کردی، ترتیب اینه: دستور مقصد, مبدا (مقصد اول).

دستهٔ ۱: جابه‌جایی داده (data movement)

mov — کپی کن (move)

asm
mov eax, edx      ; مقدار edx رو کپی کن توی eax
mov eax, [esp+0x20] ; مقداری که در حافظهٔ [esp+0x20] هست رو بریز توی eax

پایه‌ای‌ترین دستور. چیزی رو از یک جا به جای دیگه کپی می‌کنه. (مبدأ دست‌نخورده می‌مونه.)

push / pop — گذاشتن/برداشتن روی پشته

asm
push ebp    ; مقدار ebp رو بذار بالای پشته (stack)
pop  ebp    ; بالای پشته رو بردار بذار توی ebp

توی مقدمه و پایان هر تابع می‌بینیشون (برای ذخیره و بازیابی رجیسترها).

lea — آدرس رو بگیر (load effective address)

asm
lea eax, [esp+0x2c]   ; آدرسِ [esp+0x2c] رو بذار توی eax (نه محتواش!)

تفاوت مهم با mov:

mov eax, [X] → محتوای خانهٔ X
lea eax, [X] → آدرسِ خانهٔ X
دستهٔ ۲: محاسبات (arithmetic)

add / sub — جمع و تفریق

asm
add eax, [esp+0x20]   ; eax = eax + مقدار [esp+0x20]   ← همون قلب رمزگذاری!
sub esp, 0x130        ; esp = esp - 0x130  (رزرو فضا روی پشته)

not — معکوسِ بیتی (NOT)

asm
not eax     ; تمام بیت‌های eax رو برعکس کن (0→1, 1→0)

توی محاسبهٔ strlen دیدیش (~i).

دستهٔ ۳: جابه‌جایی با تغییر اندازه (مهم و کمی گیج‌کننده)

movzx — کپی با پر کردن صفر (move with zero-extend)

asm
movzx eax, BYTE PTR [eax]  ; یک بایت (۸ بیت) رو بخون، بقیهٔ eax رو با صفر پر کن

چرا لازمه؟ eax یک جعبهٔ ۳۲ بیتیه، ولی یک کاراکتر فقط ۸ بیته. movzx کاراکتر کوچیک رو می‌ذاره توی جعبهٔ بزرگ و باقی رو صفر می‌کنه.

movsx — کپی با حفظ علامت (move with sign-extend)

asm
movsx eax, al    ; مثل movzx، ولی علامت (مثبت/منفی) رو حفظ می‌کنه

تفاوت ساده:

	بایت 0xFF → eax
movzx	0x000000FF (می‌شه +255)
movsx	0xFFFFFFFF (می‌شه -1)
دستهٔ ۴: مقایسه (comparison)

این دو تا چیزی رو تغییر نمی‌دن — فقط نتیجه رو برای پرشِ بعدی آماده می‌کنن:

cmp — مقایسه کن (compare)

asm
cmp ebx, eax    ; ebx رو با eax مقایسه کن (در واقع ebx - eax حساب می‌کنه)

test — چک کن (معمولاً برای صفر بودن)

asm
test eax, eax   ; چک کن eax صفره یا منفی یا مثبت

test eax, eax یک ترفند رایجه برای فهمیدن اینکه eax صفره یا نه.

دستهٔ ۵: پرش‌ها (jumps) — تصمیم‌گیری

بعد از cmp یا test میان و تصمیم می‌گیرن کجا بری:

دستور	معنی	کِی می‌پره
jmp	Jump	همیشه (بی‌قید و شرط)
je	Jump if Equal	اگه مساوی بود
jne	Jump if Not Equal	اگه نامساوی بود
jns	Jump if Not Signed	اگه منفی نبود
jle	Jump if Less or Equal	اگه ≤ بود
jb	Jump if Below	اگه کوچکتر بود

مثال از کد خودت:

asm
cmp ebx, eax
jb  8048975     ; اگه ebx < eax بود، بپر به 8048975 (ادامهٔ حلقه)
دستهٔ ۶: توابع (functions)

call — تابع رو صدا بزن

asm
call 80484c0 <putchar@plt>   ; تابع putchar رو اجرا کن

ret — از تابع برگرد (return)

asm
ret    ; به جایی که call شده بود برگرد
دستهٔ ۷: متفرقه

and / xor — عملیات بیتی

asm
and esp, 0xfffffff0   ; تراز کردن پشته (آخرین بیت‌ها رو صفر می‌کنه)
xor eax, eax          ; eax = 0  (سریع‌ترین راه صفر کردن یک رجیستر!)

نکتهٔ بامزه: xor eax, eax یعنی «eax رو با خودش XOR کن» که همیشه صفر می‌شه — روش استاندارد صفر کردن.

nop — هیچ کاری نکن (no operation)

asm
nop    ; فقط یک کلاک وقت بگیر، هیچ کاری نکن (برای تراز یا پر کردن فضا)

اون nopهای ته برنامه فقط فضای خالیِ بعد از تابع‌ان.

repnz scas — جستجوی سریع در رشته
این ترکیب برای پیدا کردن null ته رشته (یعنی محاسبهٔ strlen) استفاده می‌شه. فعلاً همینقدر کافیه که بدونی «داره طول رشته رو می‌شماره».

🎯 خلاصهٔ کاربردی

برای خوندن هر اسمبلی، این ۵ تا رو بشناس، ۸۰٪ کار راه می‌افته:

mov  → کپی
add/sub → جمع/تفریق
cmp/test → مقایسه
j??  → پرش (تصمیم)
call → صدا زدن تابع